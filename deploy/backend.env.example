# Backend environment for production (Coolify -> backend -> Environment Variables -> Developer view).
# Replace every <...>; never commit real values.


# Database: the Coolify PostgreSQL resource (image postgis/postgis:16-3.5), internal host name from its page.
DB_URL=jdbc:postgresql://<postgres-internal-host>:5432/spotonslot
DB_USERNAME=spotonslot
DB_PASSWORD=<postgres-password>

# Addresses of the frontends (no trailing slash). CORS also covers the WebSocket handshake on /ws.
CORS_ALLOWED_ORIGINS=https://app.spotonslot.com,https://spotonslot.com,https://www.spotonslot.com
WEB_BASE_URL=https://app.spotonslot.com
LANDING_BASE_URL=https://spotonslot.com

# Signing key for access tokens, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=<random-secret>

# SMTP (port 587 + STARTTLS; Hetzner blocks 25 and 465). The sender domain needs SPF and DKIM at the provider.
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=no-reply@spotonslot.com
# Optional: contact in account e-mails ("to nie ja"), defaults to MAIL_FROM.
MAIL_CONTACT=kontakt@spotonslot.com

# Media: Cloudflare R2 (S3 API). Endpoint from the R2 page, keys from an R2 API token with Object Read & Write on the bucket.
MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_REGION=auto
MEDIA_BUCKET=spotonslot-media
MEDIA_ACCESS_KEY=<r2-access-key-id>
MEDIA_SECRET_KEY=<r2-secret-access-key>
MEDIA_PUBLIC_BASE_URL=https://media.spotonslot.com

# Geocoder: the Photon container (deploy/photon), reached over the Coolify network.
# Until it is up, https://photon.komoot.io works for a test run (fair use only).
LOCATION_GEOCODER_URL=http://<photon-internal-host>:2322
