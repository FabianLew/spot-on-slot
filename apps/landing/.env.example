# Backend API base URL (required in production)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public landing URL, used for metadataBase and hreflang links (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Data controller shown in the privacy clause and footer (required in production)
NEXT_PUBLIC_PRIVACY_CONTROLLER=
# Data controller contact e-mail (required in production)
NEXT_PUBLIC_PRIVACY_EMAIL=
# Set to "production" to enforce the required variables above at build time
LANDING_ENV=
# Umami website id; leave empty to load no analytics (local dev, previews)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami script address, only for a self-hosted Umami (default https://cloud.umami.is/script.js)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
